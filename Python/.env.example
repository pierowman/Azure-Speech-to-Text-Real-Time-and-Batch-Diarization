# Flask Settings
FLASK_SECRET_KEY=change-me-to-a-random-secret-key
FLASK_DEBUG=false

# Azure Speech Service
# Authentication uses Microsoft Entra ID (Managed Identity in Azure, or your
# Azure CLI / VS Code sign-in when running locally). No subscription key is used.
# The endpoint is built automatically from AZURE_SPEECH_RESOURCE_NAME and AZURE_CLOUD.
AZURE_SPEECH_REGION=your-region-here

# Components used to build the Speech resource's ARM resource ID
# (required for real-time Entra ID auth). These are combined into:
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_SPEECH_RESOURCE_NAME=your-speech-resource

# Azure Cloud: 'AzureCloud' (commercial, default) or 'AzureUSGovernment'
AZURE_CLOUD=AzureCloud

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=speech-transcriptions

# IMPORTANT: Set to 'true' to enable blob storage
ENABLE_BLOB_STORAGE=false

# Authentication:
# Uses DefaultAzureCredential everywhere - a Managed Identity in Azure, or your
# local Azure CLI (`az login`) / VS Code sign-in for local development.
# Optional: set AZURE_CLIENT_ID only when using a USER-ASSIGNED managed identity.
# Leave blank for a system-assigned identity or local development.
AZURE_CLIENT_ID=

# Upload Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=524288000

# Allowed Extensions
REALTIME_ALLOWED_EXTENSIONS=.wav
BATCH_ALLOWED_EXTENSIONS=.wav,.mp3,.ogg,.flac,.opus,.m4a,.webm

# Default Transcription Settings
DEFAULT_LOCALE=en-US
DEFAULT_MIN_SPEAKERS=2
DEFAULT_MAX_SPEAKERS=5

# Batch Job Settings
SHOW_TRANSCRIPTION_JOBS_TAB=true
ENABLE_BATCH_TRANSCRIPTION=true
BATCH_JOB_AUTO_REFRESH_SECONDS=60

# Cache Settings
LOCALES_CACHE_DURATION_HOURS=24

# Audio File Settings
KEEP_AUDIO_FILES=true
AUDIO_FILE_RETENTION_HOURS=24

# Transcription Estimation
WORDS_PER_SECOND=2.5
MIN_SEGMENT_DURATION_SECONDS=2.0

# File Size Limits (in bytes)
REALTIME_MAX_FILE_SIZE=104857600
BATCH_MAX_FILE_SIZE=1073741824
BATCH_MAX_FILES=100

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=10

# Polling Configuration
TRANSCRIPTION_POLL_INTERVAL_SECONDS=0.5
